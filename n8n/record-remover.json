      ],
      "parameters": {
        "content": "## Record Remover (Workflow 8)\nPOST /finance-delete { tab, match }. Reads the tab, finds the FIRST row matching every field in `match`, and deletes it via Sheets batchUpdate deleteDimension. 400 if no row matches — nothing is deleted.\n\nTransactions match on all 7 fields; Goals on goal_name; Assets on asset_name.",
        "height": 240,
        "width": 540,
        "color": 4
      }
    },
    {
      "id": "wh1",
      "name": "Delete Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "finance-delete",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "e5544460-e0e0-4f6b-93eb-533f6e7ad0ea"
    },
    {
      "id": "prep1",
      "name": "Prep Delete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b = $json.body || {};\nreturn [{ json: { tab: String(b.tab || ''), match: b.match || {} } }];"
      }
    },
    {
      "id": "http1",
      "name": "Get Sheet Meta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {},
        "url": "https://sheets.googleapis.com/v4/spreadsheets/16vNm0PPxV-OP1Kp_INOKiBz33YcL-ZkowAyRw7HnwcI?fields=sheets.properties"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "eo7uMjjFUzvjTAGi",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "http2",
      "name": "Read Tab",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {},
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/16vNm0PPxV-OP1Kp_INOKiBz33YcL-ZkowAyRw7HnwcI/values/' + encodeURIComponent($('Prep Delete').first().json.tab) + '?valueRenderOption=UNFORMATTED_VALUE' }}"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "eo7uMjjFUzvjTAGi",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "code1",
      "name": "Find Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const prep = $('Prep Delete').first().json;\nconst tab = prep.tab;\nconst match = prep.match || {};\nconst meta = $('Get Sheet Meta').first().json;\nconst sheet = (meta.sheets || []).find(function (s) { return s.properties.title === tab; });\nif (!sheet) return [{ json: { found: false, error: 'tab not found: ' + tab } }];\nconst sheetId = sheet.properties.sheetId;\nconst values = ($('Read Tab').first().json.values) || [];\nif (values.length < 2) return [{ json: { found: false, error: 'no data rows in ' + tab } }];\nfunction toISO(d){ if (typeof d === 'number') return new Date(Math.round((d-25569)*86400000)).toISOString().slice(0,10); return String(d).slice(0,10); }\nconst head = values[0];\nlet foundIndex = -1;\nfor (let i = 1; i < values.length; i++) {\n  const o = {};\n  head.forEach(function (h, j) { o[h] = values[i][j] === undefined ? '' : values[i][j]; });\n  let ok = true;\n  for (const k of Object.keys(match)) {\n    let a = o[k]; let b = match[k];\n    if (k === 'amount') { a = Number(a); b = Number(b); }\n    else if (k === 'date') { a = toISO(a); b = toISO(b); }\n    else { a = String(a == null ? '' : a); b = String(b == null ? '' : b); }\n    if (String(a) !== String(b)) { ok = false; break; }\n  }\n  if (ok) { foundIndex = i; break; }\n}\nif (foundIndex === -1) return [{ json: { found: false, error: 'row not found' } }];\nreturn [{ json: { found: true, body: { requests: [{ deleteDimension: { range: {\n  sheetId: sheetId, dimension: 'ROWS', startIndex: foundIndex, endIndex: foundIndex + 1\n} } }] } } }];"
      }
    },
    {
      "id": "if1",
      "name": "Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
