    {
      "id": "note1",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -260
      ],
      "parameters": {
        "content": "## Budget Warning Alert (Workflow 5)\nDaily 12pm (Asia/Dhaka): sends ONLY if month expenses >= 80% of month income (no per-category budgets exist in the Sheet, so the threshold from lib/constants.ts applies to the total). Numbers come pre-computed from Workflow 1.",
        "height": 220,
        "width": 520,
        "color": 4
      }
    },
    {
      "id": "sched1",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 12,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "http1",
      "name": "Fetch Dashboard Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        90
      ],
      "parameters": {
        "url": "https://asim.sg-node8n.serverdoor.com/webhook/finance-dashboard",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "code1",
      "name": "Build Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        90
      ],
      "parameters": {
        "jsCode": "\nlet force = false;\ntry { force = String($('Manual Test Trigger').first().json.query.force) === 'true'; } catch (e) { force = false; }\nconst d = $json;\nconst m = d.metrics || {};\nconst taka = function (n) {\n  n = Number(n) || 0;\n  // Manual Indian-style grouping (12,34,567) — the n8n sandbox's\n  // toLocaleString('en-IN') is unreliable (partial ICU).\n  const s = String(Math.round(Math.abs(n)));\n  const grouped = s.length > 3\n    ? s.slice(0, -3).replace(/\\B(?=(\\d{2})+(?!\\d))/g, ',') + ',' + s.slice(-3)\n    : s;\n  return (n < 0 ? '-' : '') + '\\u09f3' + grouped;\n};\n\n// No per-category budgets exist in the Sheet, so the 80% threshold\n// (BUDGET_WARNING_THRESHOLD in lib/constants.ts) applies to the month total.\nconst ratio = Number(m.income) > 0 ? Number(m.expenses) / Number(m.income) : 1;\nconst pct = Math.round(ratio * 100);\nconst send = ratio >= 0.8;\nconst forced = force && !send;\nconst subject = 'Finance OS warning: spending at ' + pct + '% of income';\nconst lines = [\n  'Budget warning from Finance OS',\n  '',\n  'Expenses this month are ' + pct + '% of income (alert threshold: 80%).',\n  '',\n  'Income: ' + taka(m.income),\n  'Expenses: ' + taka(m.expenses),\n  'Net: ' + taka(m.net),\n  'Safe to spend: ' + taka(m.safeToSpend) + ' (' + m.daysLeftInMonth + ' days left)',\n  '',\n  'Spending by category:'\n];\nfor (const c of d.spendingByCategory || []) lines.push('- ' + c.category + ': ' + taka(c.amount));\n\nif (forced) lines.push('', '(sent by manual test trigger \\u2014 the normal condition was not met)');\nlines.push('', 'Dashboard: https://finance-os-eight-delta.vercel.app/');\nreturn [{ json: { send: send || force, forced: forced, subject: subject, body: lines.join('\\n') } }];\n"
      }
    },
    {
      "id": "if1",
      "name": "Should Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        90
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.send === true }}",
              "rightValue": "",
